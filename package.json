{
  "name": "slidev-kit-workspace",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Slidev Kit development workspace. The distributable CLI is packages/cli (slidev-kit); theme assets live only in packages/theme.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "packages/theme/charts"
  ],
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "slidev-agent": "0.1.0",
    "slidev-charts": "0.1.0",
    "slidev-core": "0.1.0",
    "slidev-mcp": "0.1.0",
    "slidev-runner": "0.1.0",
    "yaml": "^2.8.0"
  },
  "peerDependencies": {
    "@slidev/cli": ">=53.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@slidev/cli": "53.0.0",
    "@slidev/parser": "53.0.0",
    "@slidev/types": "53.0.0",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "markdown-it": "14.3.3",
    "pdf-lib": "1.17.1",
    "playwright-chromium": "1.61.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-tsc": "3.3.13"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "verify": "npm test && npm run typecheck",
    "e2e": "node scripts/e2e.mjs",
    "dev": "slidev examples/quickstart/slides.md",
    "build": "npm run phase1:check -- examples/quickstart/slides.md && slidev build examples/quickstart/slides.md",
    "export": "npm run phase1:check -- examples/quickstart/slides.md && slidev export examples/quickstart/slides.md --output dist/quickstart.pdf",
    "examples:pdf": "node scripts/export-example-pdfs.mjs",
    "catalog": "node scripts/phase1/generate-catalog.mjs",
    "catalog:check": "node scripts/phase1/generate-catalog.mjs --check",
    "inventory": "node scripts/inventory/generate-inventory.mjs",
    "inventory:check": "node scripts/inventory/generate-inventory.mjs --check",
    "phase1:check": "node scripts/phase1/check-phase1.mjs",
    "phase1:browser": "node scripts/phase1/verify-phase1-browser.mjs",
    "phase2:expansion:check": "node scripts/phase2/check-expansion.mjs",
    "phase2:expansion:browser": "node scripts/phase2/verify-phase2-browser.mjs --expansion --corporate && node scripts/phase2/verify-phase2-browser.mjs --expansion",
    "phase2:check": "node scripts/phase2/check-phase2.mjs",
    "phase2:browser": "node scripts/phase2/verify-phase2-browser.mjs --corporate && node scripts/phase2/verify-phase2-browser.mjs"
  }
}
