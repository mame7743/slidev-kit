{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vite/client"]
  },
  "include": [
    "packages/core/components/visuals/GanttChart.vue",
    "packages/core/components/visuals/FitBox.vue",
    "packages/core/components/visuals/CoverImage.vue",
    "packages/core/components/kit/**/*.vue",
    "packages/core/lib/**/*.ts",
    "packages/core/setup/**/*.ts",
    "packages/core/tests/**/*.ts",
    "packages/charts/components/**/*.vue",
    "packages/charts/src/**/*.d.ts",
    "packages/charts/src/**/*.d.mts",
    "packages/charts/src/csv/client/**/*.ts",
    "packages/charts/tests/**/*.ts"
  ]
}
